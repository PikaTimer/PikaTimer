<GridPane hgap="10.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="700.0" prefWidth="800.0" vgap="2.0" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pikatimer.race.FXMLAwardDetailsController">
   <columnConstraints>
      <ColumnConstraints fillWidth="false" hgrow="NEVER" maxWidth="225.0" minWidth="200.0" prefWidth="225.0" />
      <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="367.0" prefWidth="379.0" />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints fillHeight="false" valignment="CENTER" vgrow="SOMETIMES" />
      <RowConstraints fillHeight="false" valignment="CENTER" vgrow="NEVER" />
      <RowConstraints maxHeight="1.7976931348623157E308" valignment="TOP" vgrow="ALWAYS" />
   </rowConstraints>
   <children>
      <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="5.0" GridPane.columnSpan="2">
         <children>
            <Label fx:id="selectedRaceLabel" text="Selected Event: " HBox.hgrow="NEVER">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <ComboBox fx:id="raceComboBox" prefWidth="200.0" />
         </children>
         <padding>
            <Insets bottom="10.0" />
         </padding>
         <GridPane.margin>
            <Insets />
         </GridPane.margin>
      </HBox>
      <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1">
         <GridPane.margin>
            <Insets />
         </GridPane.margin>
         <children>
            <HBox maxWidth="1.7976931348623157E308">
               <children>
                  <Label text="Award Category Setup">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <padding>
                        <Insets bottom="10.0" />
                     </padding>
                  </Label>
                  <Pane maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#addAwardCategory" text="Add Award" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label text="Tie Handling:">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                  <CheckBox fx:id="permitTiesCheckBox" mnemonicParsing="false" text="Permit Ties">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </CheckBox>
                  <Pane HBox.hgrow="ALWAYS" />
                  <Label text="Divisions:">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                  <ChoiceBox fx:id="sexHandlingChoiceBox" prefHeight="25.0" prefWidth="170.0" />
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="5.0" GridPane.rowIndex="1" GridPane.rowSpan="2" GridPane.valignment="TOP" GridPane.vgrow="ALWAYS">
         <children>
            <Label text="Sex and Age Group Setup">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <VBox fx:id="agCustomVBox1" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="2.0" VBox.vgrow="NEVER">
               <children>
                  <Label maxWidth="1.7976931348623157E308" text="Sex / Gender Labels" wrapText="true">
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                     <padding>
                        <Insets top="10.0" />
                     </padding>
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                  <TableView fx:id="sexCodeMapTableView" editable="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="125.0">
                     <columns>
                        <TableColumn fx:id="sexCodeTableColumn" maxWidth="40.0" minWidth="40.0" prefWidth="40.0" text="Code" />
                        <TableColumn fx:id="sexLabelTableColumn" prefWidth="75.0" text="Name" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <HBox alignment="CENTER_RIGHT" spacing="5.0" VBox.vgrow="NEVER">
                     <children>
                        <Button fx:id="sexCodeEdit" mnemonicParsing="false" text="Edit" />
                        <Pane maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <Button fx:id="sexCodeDelete" mnemonicParsing="false" text="Delete" />
                        <Button fx:id="sexCodeAdd" mnemonicParsing="false" text="Add" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets top="5.0" />
               </padding>
            </VBox>
            <Label text="Age Group Setup">
               <font>
                  <Font size="16.0" />
               </font>
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
               <padding>
                  <Insets top="10.0" />
               </padding>
            </Label>
            <ToggleSwitch fx:id="agCustomToggleSwitch" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="20.0" prefWidth="160.0" text="Custom Increments " />
            <GridPane fx:id="agGridPane" hgap="2.0" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="140.0" vgap="2.0">
               <columnConstraints>
                  <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" maxWidth="80.0" minWidth="80.0" prefWidth="80.0" />
                  <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="10.0" prefWidth="55.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints fillHeight="false" maxHeight="25.0" minHeight="25.0" prefHeight="25.0" vgrow="NEVER" />
                  <RowConstraints minHeight="10.0" vgrow="NEVER" />
               </rowConstraints>
               <children>
                  <Label prefHeight="17.0" prefWidth="56.0" text="Increment" />
                  <Label text="1st AG End" GridPane.rowIndex="1" />
                  <ChoiceBox fx:id="agIncrementChoiceBox" maxWidth="1.7976931348623157E308" prefHeight="25.0" prefWidth="50.0" GridPane.columnIndex="1" />
                  <TextField fx:id="agStartTextField" maxWidth="1.7976931348623157E308" minWidth="50.0" prefWidth="50.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               </children>
            </GridPane>
            <VBox fx:id="agCustomVBox" maxHeight="1.7976931348623157E308" spacing="2.0" VBox.vgrow="ALWAYS">
               <children>
                  <ToggleSwitch fx:id="customAGNamesToggleSwitch" maxWidth="-Infinity" minWidth="-Infinity" prefHeight="20.0" prefWidth="160.0" text="Custom AG Names">
                     <padding>
                        <Insets top="2.0" />
                     </padding></ToggleSwitch>
                  <Label maxWidth="1.7976931348623157E308" text="Age Group Ranges:" wrapText="true">
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                     <padding>
                        <Insets top="5.0" />
                     </padding>
                  </Label>
                  <TableView fx:id="customAGTableView" editable="true" maxHeight="1.7976931348623157E308" prefHeight="150.0" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="startAGTableColumn" maxWidth="40.0" minWidth="40.0" prefWidth="40.0" text="Start" />
                        <TableColumn fx:id="endAGTableColumn" maxWidth="40.0" minWidth="40.0" prefWidth="40.0" text="End" />
                      <TableColumn fx:id="nameAGTableColumn" prefWidth="75.0" text="Name" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <HBox alignment="CENTER_RIGHT" spacing="5.0" VBox.vgrow="NEVER">
                     <children>
                        <Button fx:id="agCustomEditButton" mnemonicParsing="false" text="Edit" />
                        <Pane maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <Button fx:id="agCustomDeleteButton" mnemonicParsing="false" text="Delete" />
                        <Button fx:id="agCustomAddButton" mnemonicParsing="false" text="Add" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         <GridPane.margin>
            <Insets top="2.0" />
         </GridPane.margin>
      </VBox>
      <ScrollPane fitToWidth="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="649.0" prefWidth="690.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
         <content>
            <VBox fx:id="awardsVBox" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" />
         </content>
         <GridPane.margin>
            <Insets />
         </GridPane.margin>
      </ScrollPane>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</GridPane>
